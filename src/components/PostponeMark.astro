---
import { Image } from 'astro:assets';
import logo from '../assets/postpone-logo.png';

// Postpone's app icon (src/assets/postpone-logo.png).
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<Image src={logo} alt="Postpone logo" width={size} height={size} densities={[1, 2]} class={className} />

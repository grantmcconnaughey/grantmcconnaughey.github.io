---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedPosts, postPath, formatDate, readingTime, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    // postPath => "/blog/2020/03/16/announcing-postpone/" ; strip the "/blog/" prefix and trailing slash
    params: { path: postPath(post).replace(/^\/blog\//, '').replace(/\/$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const minutes = readingTime(post.body);
---

<Base title={post.data.title} type="article">
  <article class="container narrow">
    <a class="back" href="/blog/">← All writing</a>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {post.data.categories.map((c) => <span class="chip">{c}</span>)}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <hr />
    <p class="muted">
      Thanks for reading! Find me on <a href="https://bsky.app/profile/grantmcconnaughey.com">Bluesky</a>
      or go back to <a href="/blog/">all posts</a>.
    </p>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .post-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-faint);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
  }
</style>
